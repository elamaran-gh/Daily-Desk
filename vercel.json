{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/_/backend/:path*" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}